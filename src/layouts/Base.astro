---
interface Props {
	title: string;
	description: string;
}
const { title, description } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) =>
	href === '/' ? path === '/' : path.startsWith(href);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/logo.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:image" content="/images/goguru-lineup.jpg" />
		<title>{title}</title>
	</head>
	<body>
		<header class="nav">
			<div class="wrap nav-inner">
				<a href="/" class="brand">
					<img src="/logo.png" alt="Brand in Progress" width="36" height="36" />
					<span>Brand in Progress</span>
				</a>
				<nav>
					<a href="/" aria-current={isActive('/') ? 'page' : undefined}>Home</a>
					<a href="/case-studies" aria-current={isActive('/case-studies') ? 'page' : undefined}>Case Studies</a>
					<a href="/about" aria-current={isActive('/about') ? 'page' : undefined}>About</a>
					<a href="/#contact" class="btn-nav">Contact</a>
				</nav>
			</div>
		</header>

		<slot />

		<footer>
			<div class="wrap footer-inner">
				<img src="/logo.png" alt="" width="28" height="28" />
				<p>© 2026 Brand in Progress — Hong Kong</p>
				<span class="footer-links">
					<a href="/privacy">Privacy Policy</a>
					<a href="/terms">Terms of Use</a>
				</span>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--brand: #f5b800;
		--ink: #141414;
		--paper: #fafaf8;
		--muted: #5a5a5a;
		--line: #e8e6e0;
	}
	* {
		margin: 0;
		box-sizing: border-box;
	}
	html {
		scroll-behavior: smooth;
	}
	body {
		font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
		background: var(--paper);
		color: var(--ink);
		line-height: 1.6;
	}
	img {
		max-width: 100%;
		display: block;
	}
	.wrap {
		max-width: 72rem;
		margin: 0 auto;
		padding: 0 1.5rem;
	}
	.kicker {
		color: var(--brand);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		font-size: 0.8rem;
	}
	h2 {
		font-size: clamp(1.6rem, 3.5vw, 2.4rem);
		line-height: 1.15;
		letter-spacing: -0.01em;
	}
	section {
		padding: 4.5rem 0;
	}
	.btn {
		display: inline-block;
		background: var(--ink);
		color: #fff;
		text-decoration: none;
		font-weight: 600;
		padding: 0.9rem 2.1rem;
		border-radius: 999px;
		transition:
			background 0.2s ease,
			color 0.2s ease,
			transform 0.15s ease;
	}
	.btn:hover {
		background: var(--brand);
		color: var(--ink);
		transform: translateY(-2px);
	}

	/* NAV (shared) */
	.nav {
		position: sticky;
		top: 0;
		background: rgba(250, 250, 248, 0.92);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--line);
		z-index: 10;
	}
	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.7rem 1.5rem;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		text-decoration: none;
		color: var(--ink);
		font-weight: 700;
		letter-spacing: 0.02em;
	}
	.brand img {
		border-radius: 6px;
	}
	nav {
		display: flex;
		align-items: center;
		gap: 1.4rem;
	}
	nav a {
		text-decoration: none;
		color: var(--ink);
		font-weight: 500;
		font-size: 0.95rem;
	}
	nav a:hover,
	nav a[aria-current='page'] {
		color: var(--brand);
	}
	.btn-nav {
		background: var(--brand);
		color: var(--ink) !important;
		font-weight: 700 !important;
		padding: 0.5rem 1.3rem;
		border-radius: 999px;
		transition:
			transform 0.15s ease,
			box-shadow 0.15s ease;
	}
	.btn-nav:hover {
		transform: translateY(-1px);
		box-shadow: 0 6px 16px rgba(245, 184, 0, 0.45);
	}

	/* FOOTER (shared) */
	footer {
		border-top: 1px solid var(--line);
		padding: 1.4rem 0;
	}
	.footer-inner {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		color: var(--muted);
		font-size: 0.85rem;
		flex-wrap: wrap;
	}
	.footer-inner img {
		border-radius: 5px;
	}
	.footer-links {
		margin-left: auto;
		display: flex;
		gap: 1.2rem;
	}
	.footer-links a {
		color: var(--muted);
		text-decoration: none;
	}
	.footer-links a:hover {
		color: var(--brand);
	}

	@media (max-width: 860px) {
		nav a:not(.btn-nav) {
			display: none;
		}
	}
</style>
