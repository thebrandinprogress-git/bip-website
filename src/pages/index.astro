---
import Base from '../layouts/Base.astro';
import {
	SITE_TITLE,
	SITE_DESCRIPTION,
	CONTACT_EMAIL,
	CONTACT_ADDRESS,
	LINKEDIN_URL,
	INSTAGRAM_URL,
	TURNSTILE_SITE_KEY,
	CONTACT_FORM_ENABLED,
} from '../consts';

const cases = [
	{
		img: '/images/goggles.jpg',
		title: 'GOGURU Swimming Goggles',
		sector: 'Sport & Action',
		text: 'A new goggle combining the reliability of sport equipment with the elegance of a fashion accessory — from concept to production-ready product.',
	},
	{
		img: '/images/grip.jpg',
		title: 'Ergonomic Scuba Hand Grip',
		sector: 'Ergonomic Design',
		text: 'Engineered inside-out for a leading Italian diving brand: the internal mechanism first, then an ergonomic shell built around it.',
	},
	{
		img: '/images/medical.jpg',
		title: 'ADIPOPIMER Medical Device',
		sector: 'Medical & Wellness',
		text: 'A custom disposable device designed for KORPO, a medical company based in Genova, Italy — making adipose tissue suitable for injection with standard syringes.',
	},
	{
		img: '/images/toys.jpg',
		title: 'Frozen 2 Licensed Toys',
		sector: 'Toys & Collectibles',
		text: 'Wearable and collectible toys developed for Giochi Preziosi under the Disney Frozen 2 franchise — from mechanism to shelf.',
	},
	{
		img: '/images/riviera.jpg',
		title: 'Riviera Beach Collection',
		sector: 'Fashion & Lifestyle — RIVIERA',
		text: 'A full end-to-end collection: bucket bags and flip-flops across 16 SKUs, from 2D drawings and material research to the marketing photoshoot.',
	},
];

const categories = [
	{ img: '/images/goggles.jpg', name: 'Sport & Action', detail: 'Swimming goggles, diving equipment and technical sport gear' },
	{ img: '/images/cat-sport.jpg', name: 'Sport & Style', detail: 'OCULUS swim collection · Carrera Sport' },
	{ img: '/images/cat-fashion.jpg', name: 'Fashion & Lifestyle', detail: 'RIVIERA bags, flip-flops & swimwear · REPLAY' },
	{ img: null, name: 'Gifts & Premium', detail: 'Promotional products and kitchenware that bring joy to everyday life' },
	{ img: '/images/cat-toys.jpg', name: 'Toys & Collectibles', detail: 'Disney Frozen 2 figures · interchangeable watches' },
	{ img: '/images/medical.jpg', name: 'Medical & Wellness', detail: 'Custom devices for clinical professionals — KORPO, Genova' },
	{ img: null, name: 'Electronics', detail: 'SnapWireless — consumer electronics sourcing & development' },
	{ img: '/images/cat-content.jpg', name: 'Digital & Content', detail: 'Web design · product & lifestyle photography' },
];

const clients = [
	{ name: 'Disney', logo: '/images/logos/disney.png' },
	{ name: 'Giochi Preziosi', logo: '/images/logos/giochipreziosi.png' },
	{ name: 'Safilo', logo: '/images/logos/safilo.png' },
	{ name: 'Cressi Sub', logo: '/images/logos/cressi.png' },
	{ name: 'MARES', logo: '/images/logos/mares.png' },
	{ name: 'Carrera Sport', logo: null },
	{ name: 'REPLAY', logo: '/images/logos/replay.png' },
	{ name: 'SnapWireless', logo: '/images/logos/snapwireless.png' },
];
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<header class="nav">
		<div class="wrap nav-inner">
			<a href="#top" class="brand">
				<img src="/logo.png" alt="Brand in Progress" width="36" height="36" />
				<span>Brand in Progress</span>
			</a>
			<nav>
				<a href="#services">Services</a>
				<a href="#work">Work</a>
				<a href="#about">About</a>
				<a href="#contact" class="btn-nav">Contact</a>
			</nav>
		</div>
	</header>

	<main id="top">
		<!-- HERO -->
		<section class="hero">
			<div class="wrap hero-inner">
				<div>
					<p class="kicker">OEM Sourcing & Product Development — Hong Kong</p>
					<h1>Find it.<br />Make it.<br /><span>Ship it.</span></h1>
					<p class="hero-sub">
						Your product sourcing partner in Asia. We connect you with the right
						manufacturers — and when you're ready to go beyond off-the-shelf, we
						design and engineer your own custom product.
					</p>
					<a class="btn" href="#contact">Tell us about your product</a>
				</div>
				<img class="hero-img" src="/images/goggles.jpg" alt="GOGURU swimming goggles designed by Brand in Progress" />
			</div>
		</section>

		<!-- TRUSTED BY -->
		<section class="trusted">
			<div class="wrap">
				<p class="kicker">Trusted by teams at</p>
				<ul>
					{
						clients.map((c) => (
							<li>
								{c.logo && <img src={c.logo} alt="" width="28" height="28" loading="lazy" />}
								<span>{c.name}</span>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<!-- SERVICES -->
		<section id="services">
			<div class="wrap">
				<p class="kicker">What we do</p>
				<h2>Start with sourcing.<br />Grow into your own product.</h2>
				<div class="services-grid">
					<article>
						<span class="num">01</span>
						<h3>Sourcing & Supplier Matching <em>OEM</em></h3>
						<p>
							We find, vet, and negotiate with the right manufacturers for your
							product. Samples, pricing, and factory audits — handled for you.
						</p>
					</article>
					<article>
						<span class="num">02</span>
						<h3>Product Design & Engineering <em>ODM</em></h3>
						<p>
							The natural evolution of sourcing: when your product doesn't exist
							yet — concept design, 3D modeling, mechanism engineering, materials
							research, design-for-manufacturing.
						</p>
					</article>
					<article>
						<span class="num">03</span>
						<h3>Production & Quality Control</h3>
						<p>
							On-the-ground production management, quality inspections, and
							logistics — through to distribution.
						</p>
					</article>
					<article>
						<span class="num">04</span>
						<h3>Brand & Content</h3>
						<p>
							Product photography, web design, and launch content that carries your
							product's identity to market.
						</p>
					</article>
				</div>
			</div>
		</section>

		<!-- FEATURED WORK -->
		<section id="work" class="work">
			<div class="wrap">
				<p class="kicker">Featured work</p>
				<h2>Case studies</h2>
				<div class="cases">
					{
						cases.map((c) => (
							<article class="case-card">
								<div class="case-img">
									<img src={c.img} alt={c.title} loading="lazy" />
								</div>
								<div class="case-body">
									<p class="kicker">{c.sector}</p>
									<h3>{c.title}</h3>
									<p>{c.text}</p>
								</div>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<!-- CATEGORIES -->
		<section class="cats">
			<div class="wrap">
				<p class="kicker">Explore by category</p>
				<h2>Whatever your product, we've been there.</h2>
				<div class="cats-grid">
					{
						categories.map((c) => (
							<article class="cat-card">
								{c.img ? (
									<div class="cat-img">
										<img src={c.img} alt={c.name} loading="lazy" />
									</div>
								) : (
									<div class="cat-img cat-placeholder" aria-hidden="true">BIP</div>
								)}
								<h3>{c.name}</h3>
								<p>{c.detail}</p>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<!-- ABOUT -->
		<section id="about" class="about">
			<div class="wrap about-inner">
				<div>
					<p class="kicker">About us</p>
					<h2>A bridge between Europe and Asia's factory floor.</h2>
					<p>
						Brand in Progress is a product sourcing and development company based in
						Hong Kong, founded by <strong>Gianluca Accardo</strong> — a product
						development engineer with 20 years of experience across design,
						industrial production, and corporate operations between Europe and Asia.
					</p>
					<p>
						From a family workshop in Italy to projects for global brands like
						Disney, REPLAY, and Safilo, Gianluca built the network and the know-how
						we now put to work for our clients: factories vetted in person, and an
						engineer who speaks both languages — literally and technically.
					</p>
					<p>
						Whether you need a reliable partner to source an existing product or a
						team to develop one from scratch, we work side by side with you — from
						first sketch or first sample to the finished product on the shelf.
					</p>
				</div>
				<ul class="stats">
					<li><strong>20</strong><span>years of experience</span></li>
					<li><strong>HK</strong><span>based, Asia-wide network</span></li>
					<li><strong>8</strong><span>global brands served</span></li>
				</ul>
			</div>
		</section>

		<!-- CONTACT -->
		<section id="contact" class="contact">
			<div class="wrap contact-inner">
				<p class="kicker">Contact</p>
				<h2>Think we'd be a good fit for your business?</h2>
				<p>Get in touch today to set up an initial meeting.</p>

				{
					CONTACT_FORM_ENABLED ? (
						<form id="contact-form" class="contact-form" novalidate>
							<div class="form-row">
								<label>
									Name
									<input type="text" name="name" required autocomplete="name" />
								</label>
								<label>
									Email
									<input type="email" name="email" required autocomplete="email" />
								</label>
							</div>
							<label>
								Subject
								<input type="text" name="subject" required />
							</label>
							<label>
								Message
								<textarea name="message" rows="5" required />
							</label>
							<div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} />
							<button type="submit" class="btn">Send message</button>
							<p class="form-status" role="status" aria-live="polite" />
						</form>
					) : (
						<div class="contact-actions">
							<a class="btn" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
						</div>
					)
				}

				<ul class="contact-meta">
					<li>{CONTACT_ADDRESS}</li>
					<li>
						<a href={LINKEDIN_URL} target="_blank" rel="noopener" aria-label="Brand in Progress on LinkedIn">
							<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/></svg>
							LinkedIn
						</a>
					</li>
					<li>
						<a href={INSTAGRAM_URL} target="_blank" rel="noopener" aria-label="Brand in Progress on Instagram">
							<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.15 3.23-1.66 4.77-4.92 4.92-1.27.06-1.64.07-4.85.07s-3.58-.01-4.85-.07c-3.26-.15-4.77-1.7-4.92-4.92C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85C2.38 3.92 3.9 2.38 7.15 2.23 8.42 2.17 8.8 2.16 12 2.16zm0 3.68a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32zm0 10.16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.4-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88z"/></svg>
							Instagram
						</a>
					</li>
				</ul>
			</div>
		</section>
	</main>

	<footer>
		<div class="wrap footer-inner">
			<img src="/logo.png" alt="" width="28" height="28" />
			<p>© 2026 Brand in Progress — Hong Kong</p>
			<span class="footer-links">
				<a href="/privacy">Privacy Policy</a>
				<a href="/terms">Terms of Use</a>
			</span>
		</div>
	</footer>

	{CONTACT_FORM_ENABLED && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />}

	<script>
		const form = document.getElementById('contact-form');
		if (form) {
			form.addEventListener('submit', async (e) => {
				e.preventDefault();
				const status = form.querySelector('.form-status');
				const btn = form.querySelector('button[type="submit"]');
				btn.disabled = true;
				status.textContent = 'Sending…';
				try {
					const res = await fetch('/api/contact', {
						method: 'POST',
						body: new FormData(form),
					});
					const data = await res.json();
					if (res.ok && data.ok) {
						status.textContent = 'Thanks for contacting us! We will get back to you shortly.';
						form.reset();
					} else {
						status.textContent = data.error || 'Something went wrong. Please email us directly.';
					}
				} catch {
					status.textContent = 'Network error. Please email us directly at the address below.';
				} finally {
					btn.disabled = false;
				}
			});
		}
	</script>
</Base>

<style>
	/* NAV */
	.nav {
		position: sticky;
		top: 0;
		background: rgba(250, 250, 248, 0.92);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--line);
		z-index: 10;
	}
	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.7rem 1.5rem;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		text-decoration: none;
		color: var(--ink);
		font-weight: 700;
		letter-spacing: 0.02em;
	}
	.brand img {
		border-radius: 6px;
	}
	nav {
		display: flex;
		align-items: center;
		gap: 1.4rem;
	}
	nav a {
		text-decoration: none;
		color: var(--ink);
		font-weight: 500;
		font-size: 0.95rem;
	}
	nav a:hover {
		color: var(--brand);
	}
	.btn-nav {
		background: var(--brand);
		color: var(--ink) !important;
		font-weight: 700 !important;
		padding: 0.5rem 1.3rem;
		border-radius: 999px;
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}
	.btn-nav:hover {
		transform: translateY(-1px);
		box-shadow: 0 6px 16px rgba(245, 184, 0, 0.45);
	}

	/* HERO */
	.hero {
		padding: 5rem 0 4rem;
		background: linear-gradient(180deg, #fff 0%, var(--paper) 100%);
	}
	.hero-inner {
		display: grid;
		grid-template-columns: 1.15fr 0.85fr;
		gap: 3rem;
		align-items: center;
	}
	h1 {
		font-size: clamp(2.6rem, 6vw, 4.4rem);
		line-height: 1.02;
		letter-spacing: -0.02em;
		margin: 0.6rem 0 1.2rem;
	}
	h1 span {
		color: var(--brand);
	}
	.hero-sub {
		font-size: 1.1rem;
		color: var(--muted);
		max-width: 30rem;
		margin-bottom: 1.8rem;
	}
	.hero-img {
		border-radius: 18px;
		box-shadow: 0 24px 60px rgba(20, 20, 20, 0.14);
	}

	/* TRUSTED */
	.trusted {
		padding: 2.2rem 0;
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}
	.trusted ul {
		list-style: none;
		padding: 0;
		margin-top: 1rem;
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 2rem;
		align-items: center;
	}
	.trusted li {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		font-weight: 700;
		font-size: 1.02rem;
		letter-spacing: 0.02em;
		color: #3a3a3a;
	}
	.trusted li img {
		width: 28px;
		height: 28px;
		object-fit: contain;
		border-radius: 6px;
	}

	/* SERVICES */
	.services-grid {
		margin-top: 2.5rem;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1.2rem;
	}
	.services-grid article {
		background: #fff;
		border: 1px solid var(--line);
		border-radius: 14px;
		padding: 1.6rem;
		transition:
			transform 0.15s ease,
			box-shadow 0.15s ease;
	}
	.services-grid article:hover {
		transform: translateY(-4px);
		box-shadow: 0 14px 34px rgba(20, 20, 20, 0.08);
	}
	.num {
		color: var(--brand);
		font-weight: 800;
		font-size: 0.9rem;
	}
	.services-grid h3 {
		margin: 0.5rem 0 0.6rem;
		font-size: 1.1rem;
		line-height: 1.3;
	}
	.services-grid em {
		font-style: normal;
		font-size: 0.72rem;
		font-weight: 700;
		color: var(--brand);
		border: 1px solid var(--brand);
		border-radius: 999px;
		padding: 0.1rem 0.5rem;
		vertical-align: middle;
		margin-left: 0.3rem;
	}
	.services-grid p {
		color: var(--muted);
		font-size: 0.95rem;
	}

	/* CASE STUDIES */
	.work {
		background: #fff;
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}
	.cases {
		margin-top: 2.5rem;
		display: grid;
		grid-template-columns: repeat(6, 1fr);
		gap: 1.4rem;
	}
	.case-card {
		grid-column: span 2;
		border: 1px solid var(--line);
		border-radius: 16px;
		overflow: hidden;
		background: var(--paper);
		transition:
			transform 0.15s ease,
			box-shadow 0.15s ease;
	}
	.case-card:nth-child(1),
	.case-card:nth-child(2) {
		grid-column: span 3;
	}
	.case-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 16px 40px rgba(20, 20, 20, 0.1);
	}
	.case-img {
		background: #fff;
		padding: 0.8rem;
	}
	.case-img img {
		width: 100%;
		height: 230px;
		object-fit: contain;
	}
	.case-body {
		padding: 0.6rem 1.4rem 1.5rem;
	}
	.case-body h3 {
		margin: 0.35rem 0 0.5rem;
		font-size: 1.15rem;
	}
	.case-body p {
		color: var(--muted);
		font-size: 0.95rem;
	}

	/* CATEGORIES */
	.cats-grid {
		margin-top: 2.5rem;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
		gap: 1.2rem;
	}
	.cat-card {
		border: 1px solid var(--line);
		border-radius: 14px;
		overflow: hidden;
		background: #fff;
	}
	.cat-img {
		background: #fff;
		padding: 0.5rem;
	}
	.cat-img img {
		width: 100%;
		height: 150px;
		object-fit: contain;
	}
	.cat-placeholder {
		height: 150px;
		padding: 0;
		display: grid;
		place-items: center;
		background: linear-gradient(135deg, var(--brand) 0%, #ffd75e 100%);
		font-weight: 800;
		font-size: 1.6rem;
		color: var(--ink);
		letter-spacing: 0.08em;
	}
	.cat-card h3 {
		font-size: 1rem;
		margin: 0.7rem 1rem 0.3rem;
	}
	.cat-card p {
		color: var(--muted);
		font-size: 0.87rem;
		margin: 0 1rem 1rem;
	}

	/* ABOUT */
	.about {
		background: var(--ink);
		color: #f3f1ec;
	}
	.about .kicker {
		color: var(--brand);
	}
	.about-inner {
		display: grid;
		grid-template-columns: 1.4fr 0.6fr;
		gap: 3rem;
		align-items: start;
	}
	.about p {
		margin-top: 1rem;
		color: #cfccc4;
	}
	.about h2 {
		margin-top: 0.6rem;
	}
	.stats {
		list-style: none;
		padding: 0;
		display: grid;
		gap: 1.2rem;
	}
	.stats li {
		border: 1px solid #333;
		border-radius: 14px;
		padding: 1.2rem 1.4rem;
	}
	.stats strong {
		display: block;
		font-size: 1.9rem;
		color: var(--brand);
	}
	.stats span {
		color: #cfccc4;
		font-size: 0.9rem;
	}

	/* CONTACT */
	.contact-inner {
		text-align: center;
		max-width: 46rem;
	}
	.contact h2 {
		margin: 0.6rem 0 0.8rem;
	}
	.contact > .wrap > p,
	.contact-inner > p {
		color: var(--muted);
	}
	.contact-actions {
		margin: 1.8rem 0 1.6rem;
	}
	.contact-form {
		margin: 2rem auto 1.6rem;
		text-align: left;
		display: grid;
		gap: 1rem;
		background: #fff;
		border: 1px solid var(--line);
		border-radius: 16px;
		padding: 1.8rem;
	}
	.form-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}
	.contact-form label {
		display: grid;
		gap: 0.35rem;
		font-weight: 600;
		font-size: 0.9rem;
	}
	.contact-form input,
	.contact-form textarea {
		font: inherit;
		padding: 0.7rem 0.9rem;
		border: 1px solid var(--line);
		border-radius: 10px;
		background: var(--paper);
	}
	.contact-form input:focus,
	.contact-form textarea:focus {
		outline: 2px solid var(--brand);
		border-color: var(--brand);
	}
	.contact-form .btn {
		border: none;
		cursor: pointer;
		font-size: 1rem;
