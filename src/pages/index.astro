---
import Base from '../layouts/Base.astro';
import {
	SITE_TITLE,
	SITE_DESCRIPTION,
	CONTACT_EMAIL,
	CONTACT_ADDRESS,
	LINKEDIN_URL,
	INSTAGRAM_URL,
	TURNSTILE_SITE_KEY,
	CONTACT_FORM_ENABLED,
} from '../consts';

const clients = [
	{ name: 'Disney', logo: '/images/logos/disney.png' },
	{ name: 'Giochi Preziosi', logo: '/images/logos/giochipreziosi.png' },
	{ name: 'Safilo', logo: '/images/logos/safilo.png' },
	{ name: 'Cressi Sub', logo: '/images/logos/cressi.png' },
	{ name: 'MARES', logo: '/images/logos/mares.png' },
	{ name: 'Carrera Sport', logo: null },
	{ name: 'REPLAY', logo: '/images/logos/replay.png' },
	{ name: 'SnapWireless', logo: '/images/logos/snapwireless.png' },
];

const projects = [
	{
		img: '/images/goguru-lineup.jpg',
		title: 'GOGURU Swimming Goggles',
		sector: 'Sport & Action',
		href: '/case-studies#goguru',
	},
	{
		img: '/images/grip.jpg',
		title: 'Ergonomic Scuba Grip',
		sector: 'Ergonomic Design',
		href: '/case-studies#grip',
	},
	{
		img: '/images/medical.jpg',
		title: 'ADIPOPIMER Medical Device',
		sector: 'Medical — KORPO',
		href: '/case-studies#medical',
	},
	{
		img: '/images/toys.jpg',
		title: 'Frozen 2 Licensed Toys',
		sector: 'Toys — Disney / Giochi Preziosi',
		href: '/case-studies#toys',
	},
	{
		img: '/images/riviera.jpg',
		title: 'Riviera Beach Collection',
		sector: 'Fashion — RIVIERA',
		href: '/case-studies#riviera',
	},
];

const categoryLinks = [
	{ name: 'Sport & Action', href: '/categories/sport' },
	{ name: 'Toys & Collectibles', href: '/categories/toys' },
	{ name: 'Fashion & Lifestyle', href: '/categories/fashion' },
	{ name: 'Gifts & Premium', href: '/categories/premium' },
	{ name: 'Medical & Wellness', href: '/categories/medical' },
	{ name: 'Electronics', href: '/categories/electronics' },
	{ name: 'Digital & Content', href: '/categories/digital' },
];
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<main id="top">
		<!-- HERO -->
		<section class="hero">
			<div class="wrap hero-inner">
				<div>
					<p class="kicker">OEM Sourcing & Product Development — Hong Kong</p>
					<h1>Find it.<br />Make it.<br /><span>Ship it.</span></h1>
					<p class="hero-sub">
						Your product sourcing partner in Asia. We connect you with the right
						manufacturers — and when you're ready to go beyond off-the-shelf, we
						design and engineer your own custom product.
					</p>
					<a class="btn" href="#contact">Tell us about your product</a>
				</div>
				<img class="hero-img" src="/images/goguru-lineup.jpg" alt="GOGURU swimming goggles collection developed by Brand in Progress" />
			</div>
		</section>

		<!-- TRUSTED BY -->
		<section class="trusted">
			<div class="wrap">
				<p class="kicker">Trusted by teams at</p>
				<ul>
					{
						clients.map((c) => (
							<li>
								{c.logo && <img src={c.logo} alt="" width="28" height="28" loading="lazy" />}
								<span>{c.name}</span>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<!-- SERVICES -->
		<section id="services">
			<div class="wrap">
				<p class="kicker">What we do</p>
				<h2>Start with sourcing.<br />Grow into your own product.</h2>
				<div class="services-grid">
					<article>
						<span class="num">01</span>
						<h3>Sourcing & Supplier Matching <em>OEM</em></h3>
						<p>
							We find, vet, and negotiate with the right manufacturers for your
							product. Samples, pricing, and factory audits — handled for you.
						</p>
					</article>
					<article>
						<span class="num">02</span>
						<h3>Product Design & Engineering <em>ODM</em></h3>
						<p>
							The natural evolution of sourcing: when your product doesn't exist
							yet — concept design, 3D modeling, mechanism engineering, materials
							research, design-for-manufacturing.
						</p>
					</article>
					<article>
						<span class="num">03</span>
						<h3>Production & Quality Control</h3>
						<p>
							On-the-ground production management, quality inspections, and
							logistics — through to distribution.
						</p>
					</article>
					<article>
						<span class="num">04</span>
						<h3>Brand & Content</h3>
						<p>
							Product photography, web design, and launch content that carries your
							product's identity to market.
						</p>
					</article>
				</div>
			</div>
		</section>

		<!-- MAIN PROJECTS -->
		<section class="projects">
			<div class="wrap">
				<p class="kicker">Selected work</p>
				<h2>Main projects</h2>
				<div class="proj-grid">
					{
						projects.map((p) => (
							<a class="proj-card" href={p.href}>
								<div class="proj-img">
									<img src={p.img} alt={p.title} loading="lazy" />
								</div>
								<div class="proj-body">
									<p class="kicker">{p.sector}</p>
									<h3>{p.title}</h3>
								</div>
							</a>
						))
					}
				</div>
				<p class="more-link"><a href="/case-studies">See all case studies →</a></p>
				<ul class="cat-links">
					{categoryLinks.map((c) => <li><a href={c.href}>{c.name}</a></li>)}
				</ul>
			</div>
		</section>

		<!-- COMPANY INFO + CONTACT -->
		<section id="contact" class="contact">
			<div class="wrap contact-inner">
				<p class="kicker">Contact</p>
				<h2>Think we'd be a good fit for your business?</h2>
				<p>
					Get in touch today to set up an initial meeting. Brand in Progress is a
					product sourcing and development company based in Hong Kong, working with
					clients across Europe and Asia.
				</p>

				{
					CONTACT_FORM_ENABLED ? (
						<form id="contact-form" class="contact-form" novalidate>
							<div class="form-row">
								<label>
									Name
									<input type="text" name="name" required autocomplete="name" />
								</label>
								<label>
									Email
									<input type="email" name="email" required autocomplete="email" />
								</label>
							</div>
							<label>
								Subject
								<input type="text" name="subject" required />
							</label>
							<label>
								Message
								<textarea name="message" rows="5" required />
							</label>
							<div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} />
							<button type="submit" class="btn">Send message</button>
							<p class="form-status" role="status" aria-live="polite" />
						</form>
					) : (
						<div class="contact-actions">
							<a class="btn" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
						</div>
					)
				}

				<ul class="contact-meta">
					<li>{CONTACT_ADDRESS}</li>
					<li>
						<a href={LINKEDIN_URL} target="_blank" rel="noopener" aria-label="Brand in Progress on LinkedIn">
							<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/></svg>
							LinkedIn
						</a>
					</li>
					<li>
						<a href={INSTAGRAM_URL} target="_blank" rel="noopener" aria-label="Brand in Progress on Instagram">
							<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.15 3.23-1.66 4.77-4.92 4.92-1.27.06-1.64.07-4.85.07s-3.58-.01-4.85-.07c-3.26-.15-4.77-1.7-4.92-4.92C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85C2.38 3.92 3.9 2.38 7.15 2.23 8.42 2.17 8.8 2.16 12 2.16zm0 3.68a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32zm0 10.16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.4-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88z"/></svg>
							Instagram
						</a>
					</li>
				</ul>
			</div>
		</section>
	</main>

	{CONTACT_FORM_ENABLED && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />}

	<script>
		const form = document.getElementById('contact-form');
		if (form) {
			form.addEventListener('submit', async (e) => {
				e.preventDefault();
				const status = form.querySelector('.form-status');
				const btn = form.querySelector('button[type="submit"]');
				btn.disabled = true;
				status.textContent = 'Sending…';
				try {
					const res = await fetch('/api/contact', {
						method: 'POST',
						body: new FormData(form),
					});
					const data = await res.json();
					if (res.ok && data.ok) {
						status.textContent = 'Thanks for contacting us! We will get back to you shortly.';
						form.reset();
					} else {
						status.textContent = data.error || 'Something went wrong. Please email us directly.';
					}
				} catch {
					status.textContent = 'Network error. Please email us directly at the address below.';
				} finally {
					btn.disabled = false;
				}
			});
		}
	</script>
</Base>

<style>
	/* HERO */
	.hero {
		padding: 5rem 0 4rem;
		background: linear-gradient(180deg, #fff 0%, var(--paper) 100%);
	}
	.hero-inner {
		display: grid;
		grid-template-columns: 1.15fr 0.85fr;
		gap: 3rem;
		align-items: center;
	}
	h1 {
		font-size: clamp(2.6rem, 6vw, 4.4rem);
		line-height: 1.02;
		letter-spacing: -0.02em;
		margin: 0.6rem 0 1.2rem;
	}
	h1 span {
		color: var(--brand);
	}
	.hero-sub {
		font-size: 1.1rem;
		color: var(--muted);
		max-width: 30rem;
		margin-bottom: 1.8rem;
	}
	.hero-img {
		border-radius: 18px;
		box-shadow: 0 24px 60px rgba(20, 20, 20, 0.14);
	}

	/* TRUSTED */
	.trusted {
		padding: 2.2rem 0;
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}
	.trusted ul {
		list-style: none;
		padding: 0;
		margin-top: 1rem;
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 2rem;
		align-items: center;
	}
	.trusted li {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		font-weight: 700;
		font-size: 1.02rem;
		letter-spacing: 0.02em;
		color: #3a3a3a;
	}
	.trusted li img {
		width: 28px;
		height: 28px;
		object-fit: contain;
		border-radius: 6px;
	}

	/* SERVICES */
	.services-grid {
		margin-top: 2.5rem;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1.2rem;
	}
	.services-grid article {
		background: #fff;
		border: 1px solid var(--line);
		border-radius: 14px;
		padding: 1.6rem;
		transition:
			transform 0.15s ease,
			box-shadow 0.15s ease;
	}
	.services-grid article:hover {
		transform: translateY(-4px);
		box-shadow: 0 14px 34px rgba(20, 20, 20, 0.08);
	}
	.num {
		color: var(--brand);
		font-weight: 800;
		font-size: 0.9rem;
	}
	.services-grid h3 {
		margin: 0.5rem 0 0.6rem;
		font-size: 1.1rem;
		line-height: 1.3;
	}
	.services-grid em {
		font-style: normal;
		font-size: 0.72rem;
		font-weight: 700;
		color: var(--brand);
		border: 1px solid var(--brand);
		border-radius: 999px;
		padding: 0.1rem 0.5rem;
		vertical-align: middle;
		margin-left: 0.3rem;
	}
	.services-grid p {
		color: var(--muted);
		font-size: 0.95rem;
	}

	/* MAIN PROJECTS */
	.projects {
		background: #fff;
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}
	.proj-grid {
		margin-top: 2.5rem;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 1.2rem;
	}
	.proj-card {
		border: 1px solid var(--line);
		border-radius: 14px;
		overflow: hidden;
		background: var(--paper);
		text-decoration: none;
		color: var(--ink);
		transition:
			transform 0.15s ease,
			box-shadow 0.15s ease;
	}
	.proj-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 16px 40px rgba(20, 20, 20, 0.1);
	}
	.proj-img {
		background: #fff;
		padding: 0.6rem;
	}
	.proj-img img {
		width: 100%;
		height: 150px;
		object-fit: contain;
	}
	.proj-body {
		padding: 0.5rem 1.1rem 1.1rem;
	}
	.proj-body h3 {
		font-size: 1.02rem;
		margin-top: 0.3rem;
	}
	.more-link {
		margin-top: 1.8rem;
	}
	.more-link a {
		color: var(--ink);
		font-weight: 700;
		text-decoration: none;
		border-bottom: 2px solid var(--brand);
	}
	.more-link a:hover {
		color: var(--brand);
	}
	.cat-links {
		list-style: none;
		padding: 1.6rem 0 0;
		margin-top: 1.6rem;
		border-top: 1px solid var(--line);
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}
	.cat-links a {
		display: inline-block;
		text-decoration: none;
		color: var(--muted);
		border: 1px solid var(--line);
		border-radius: 999px;
		padding: 0.4rem 1rem;
		font-size: 0.88rem;
		font-weight: 600;
		transition:
			border-color 0.15s ease,
			color 0.15s ease;
	}
	.cat-links a:hover {
		border-color: var(--brand);
		color: var(--ink);
	}

	/* CONTACT */
	.contact-inner {
		text-align: center;
		max-width: 46rem;
	}
	.contact h2 {
		margin: 0.6rem 0 0.8rem;
	}
	.contact-inner > p {
		color: var(--muted);
	}
	.contact-actions {
		margin: 1.8rem 0 1.6rem;
	}
	.contact-form {
		margin: 2rem auto 1.6rem;
		text-align: left;
		display: grid;
		gap: 1rem;
		background: #fff;
		border: 1px solid var(--line);
		border-radius: 16px;
		padding: 1.8rem;
	}
	.form-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}
	.contact-form label {
		display: grid;
		gap: 0.35rem;
		font-weight: 600;
		font-size: 0.9rem;
	}
	.contact-form input,
	.contact-form textarea {
		font: inherit;
		padding: 0.7rem 0.9rem;
		border: 1px solid var(--line);
		border-radius: 10px;
		background: var(--paper);
	}
	.contact-form input:focus,
	.contact-form textarea:focus {
		outline: 2px solid var(--brand);
		border-color: var(--brand);
	}
	.contact-form .btn {
		border: none;
		cursor: pointer;
		font-size: 1rem;
		justify-self: start;
	}
	.contact-form .btn:disabled {
		opacity: 0.6;
		cursor: wait;
	}
	.form-status {
		font-size: 0.95rem;
		color: var(--muted);
		min-height: 1.2em;
	}
	.contact-meta {
		list-style: none;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 0.6rem 1.8rem;
		color: var(--muted);
		font-size: 0.95rem;
	}
	.contact-meta a {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		color: var(--ink);
		font-weight: 600;
		text-decoration: none;
		border-bottom: 2px solid var(--brand);
		padding-bottom: 1px;
	}
	.contact-meta a:hover {
		color: var(--brand);
	}

	@media (max-width: 860px) {
		.hero-inner {
			grid-template-columns: 1fr;
		}
		.hero-img {
			max-width: 480px;
		}
		.form-row {
			grid-template-columns: 1fr;
		}
	}
</style>
